{
  "name": "tern",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Standalone SQLite and PostgreSQL database workbench",
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:ui": "bun scripts/data-grid-smoke.ts && bun scripts/sql-editor-smoke.ts && bun scripts/connection-modal-smoke.ts && bun scripts/object-explorer-smoke.ts && bun scripts/migration-smoke.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "start": "bun server.ts",
    "test:e2e": "bun scripts/verify-postgres.ts",
    "postgres:down": "docker compose -f compose.verify.yml down"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "happy-dom": "^20.11.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3"
  }
}
